{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wechat-miniprogram-test/test-request.schema.json",
  "title": "Canonical WeChat Mini Program Test Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "requestId", "requestedAt", "authorizationRef",
    "projectAdapter", "candidate", "environment", "run", "defectLineage",
    "testPlan", "authorization", "execution", "output"
  ],
  "properties": {
    "schemaVersion": { "const": "3.1" },
    "requestId": { "type": "string", "minLength": 8 },
    "requestedAt": { "type": "string", "format": "date-time" },
    "authorizationRef": { "type": "string", "minLength": 1 },
    "projectAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "adapterId", "adapterVersion"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/hash" },
        "adapterId": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "diffHash", "sourceHash", "buildId"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "diffHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "buildId": { "type": ["string", "null"] }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "appId", "apiIdentity", "configHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "appId": { "type": ["string", "null"] },
        "apiIdentity": { "type": ["string", "null"] },
        "configHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "mode"],
      "properties": {
        "runId": { "type": "string", "minLength": 8 },
        "mode": { "enum": ["BASELINE", "TARGETED", "DEFECT_REPRODUCTION", "FIX_VERIFICATION", "REGRESSION"] }
      }
    },
    "defectLineage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineageId", "round", "source", "defects"],
          "properties": {
            "lineageId": { "type": "string", "minLength": 8 },
            "round": { "type": "integer", "minimum": 1 },
            "source": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "receiptId", "path", "sha256"],
                  "properties": {
                    "type": { "const": "PARENT_RECEIPT" },
                    "receiptId": { "type": "string", "minLength": 8 },
                    "path": { "$ref": "#/$defs/relativePath" },
                    "sha256": { "$ref": "#/$defs/hash" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "reference", "path", "sha256"],
                  "properties": {
                    "type": { "const": "EXTERNAL_EVIDENCE" },
                    "reference": { "type": "string", "minLength": 1 },
                    "path": { "$ref": "#/$defs/relativePath" },
                    "sha256": { "$ref": "#/$defs/hash" }
                  }
                }
              ]
            },
            "defects": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/defectSeed" }
            }
          }
        }
      ]
    },
    "testPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog", "strategy", "changedImpactKeys", "upstreamDepth",
        "downstreamDepth", "activeFullSuiteTriggers", "selectedScenarioIds"
      ],
      "properties": {
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "catalogId", "catalogVersion"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/hash" },
            "catalogId": { "type": "string", "minLength": 1 },
            "catalogVersion": { "type": "string", "minLength": 1 }
          }
        },
        "strategy": { "enum": ["FULL", "IMPACT"] },
        "changedImpactKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/impactKey" }
        },
        "upstreamDepth": { "type": "integer", "minimum": 0, "maximum": 2 },
        "downstreamDepth": { "type": "integer", "minimum": 0, "maximum": 2 },
        "activeFullSuiteTriggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "impact-unknown", "catalog-stale", "shared-foundation-change",
              "test-infrastructure-change", "multi-domain-change",
              "unexpected-outside-impact-failure", "release-baseline", "policy-required"
            ]
          }
        },
        "selectedScenarioIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devtoolsLifecycle", "runtimeRead", "networkAccess", "screenshot",
        "manualObservation", "loginAction", "accountSwitch", "businessWrite",
        "testDataMutation", "deviceStateChange"
      ],
      "properties": {
        "devtoolsLifecycle": { "type": "boolean" },
        "runtimeRead": { "type": "boolean" },
        "networkAccess": { "type": "boolean" },
        "screenshot": { "type": "boolean" },
        "manualObservation": { "type": "boolean" },
        "loginAction": { "type": "boolean" },
        "accountSwitch": { "type": "boolean" },
        "businessWrite": { "type": "boolean" },
        "testDataMutation": { "type": "boolean" },
        "deviceStateChange": { "type": "boolean" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalBudgetSeconds", "failFast", "maxParallelScenarios",
        "isolatedRuntimePerScenario", "readRetryLimit", "writeRetryLimit"
      ],
      "properties": {
        "totalBudgetSeconds": { "type": "integer", "minimum": 1 },
        "failFast": { "type": "boolean" },
        "maxParallelScenarios": { "type": "integer", "minimum": 1, "maximum": 4 },
        "isolatedRuntimePerScenario": { "type": "boolean" },
        "readRetryLimit": { "type": "integer", "minimum": 0, "maximum": 1 },
        "writeRetryLimit": { "const": 0 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "evidenceFileName", "receiptFileName", "overwrite"],
      "properties": {
        "root": { "$ref": "#/$defs/relativePath" },
        "evidenceFileName": { "const": "evidence.json" },
        "receiptFileName": { "const": "test-receipt.json" },
        "overwrite": { "const": false }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\]).+"
    },
    "impactKey": {
      "type": "string",
      "pattern": "^(source|page|component|api|state|data|permission|config|contract|invariant|device):.+$"
    },
    "defectSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defectId", "fingerprint", "failingAssertions"],
      "properties": {
        "defectId": { "type": ["string", "null"] },
        "fingerprint": { "$ref": "#/$defs/hash" },
        "failingAssertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenarioId", "assertionIds"],
            "properties": {
              "scenarioId": { "type": "string", "minLength": 1 },
              "assertionIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "run": { "properties": { "mode": { "const": "BASELINE" } }, "required": ["mode"] } } },
      "then": {
        "properties": {
          "defectLineage": { "type": "null" },
          "testPlan": { "properties": { "strategy": { "const": "FULL" } } }
        }
      }
    },
    {
      "if": { "properties": { "run": { "properties": { "mode": { "const": "TARGETED" } }, "required": ["mode"] } } },
      "then": {
        "properties": {
          "defectLineage": { "type": "null" },
          "testPlan": { "properties": { "strategy": { "const": "IMPACT" }, "changedImpactKeys": { "minItems": 1 } } }
        }
      }
    },
    {
      "if": { "properties": { "run": { "properties": { "mode": { "const": "DEFECT_REPRODUCTION" } }, "required": ["mode"] } } },
      "then": {
        "properties": {
          "defectLineage": { "type": "object" },
          "testPlan": {
            "properties": {
              "strategy": { "const": "IMPACT" },
              "changedImpactKeys": { "maxItems": 0 },
              "upstreamDepth": { "const": 0 },
              "downstreamDepth": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "run": { "properties": { "mode": { "const": "FIX_VERIFICATION" } }, "required": ["mode"] } } },
      "then": {
        "properties": {
          "defectLineage": {
            "type": "object",
            "properties": { "source": { "properties": { "type": { "const": "PARENT_RECEIPT" } }, "required": ["type"] } }
          },
          "testPlan": {
            "properties": {
              "strategy": { "const": "IMPACT" },
              "changedImpactKeys": { "minItems": 1 },
              "upstreamDepth": { "minimum": 1 },
              "downstreamDepth": { "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "defectLineage": {
            "type": "object",
            "properties": { "source": { "properties": { "type": { "const": "EXTERNAL_EVIDENCE" } }, "required": ["type"] } },
            "required": ["source"]
          }
        }
      },
      "then": {
        "properties": {
          "run": { "properties": { "mode": { "const": "DEFECT_REPRODUCTION" } } },
          "defectLineage": { "properties": { "round": { "const": 1 } } }
        }
      }
    },
    {
      "if": { "properties": { "testPlan": { "properties": { "strategy": { "const": "IMPACT" } }, "required": ["strategy"] } } },
      "then": { "properties": { "testPlan": { "properties": { "activeFullSuiteTriggers": { "maxItems": 0 } } } } }
    },
    {
      "if": { "properties": { "execution": { "properties": { "maxParallelScenarios": { "minimum": 2 } }, "required": ["maxParallelScenarios"] } } },
      "then": { "properties": { "execution": { "properties": { "isolatedRuntimePerScenario": { "const": true } } } } }
    }
  ]
}
