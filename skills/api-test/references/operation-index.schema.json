{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/api-test/operation-index.schema.json",
  "title": "API Contract Operation Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "serviceId", "contractCombinedSha256", "operations", "producer"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "contractId": { "$ref": "#/$defs/id" },
    "serviceId": { "$ref": "#/$defs/id" },
    "contractCombinedSha256": { "$ref": "#/$defs/hash" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "pathOrOperation", "effect", "external", "traceabilityKeys"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE", "QUERY", "MUTATION", "CALL", "CONNECT", "MESSAGE"] },
          "pathOrOperation": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["READ", "WRITE"] },
          "external": { "type": "boolean" },
          "traceabilityKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {
        "kind": { "enum": ["OPENAPI_JSON_COMPILER", "CUSTOM_EXPLICIT"] },
        "id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
