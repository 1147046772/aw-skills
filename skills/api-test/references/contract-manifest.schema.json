{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/api-test/contract-manifest.schema.json",
  "title": "Deterministic API Contract Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "format", "root", "files", "externalRefs", "transitiveLocalRefsResolved", "combinedSha256", "producer"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "contractId": { "$ref": "#/$defs/id" },
    "format": { "enum": ["openapi", "graphql", "grpc", "websocket", "custom"] },
    "root": { "$ref": "#/$defs/relativePath" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/hash" },
          "role": { "enum": ["ROOT", "REFERENCE"] }
        }
      }
    },
    "externalRefs": { "type": "array", "maxItems": 0 },
    "transitiveLocalRefsResolved": { "const": true },
    "combinedSha256": { "$ref": "#/$defs/hash" },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {
        "kind": { "enum": ["OPENAPI_JSON_COMPILER", "CUSTOM_EXPLICIT"] },
        "id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+" }
  }
}
