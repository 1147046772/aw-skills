{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/api-test/evidence.schema.json",
  "title": "API Scenario Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "requestId", "verdict", "timing", "scope", "preflight", "runtime", "requests", "steps", "assertions", "artifacts", "mutations", "excluded", "blockers"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "evidenceId": { "$ref": "#/$defs/id" },
    "requestId": { "$ref": "#/$defs/id" },
    "verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "timing": { "type": "object", "additionalProperties": false, "required": ["startedAt", "finishedAt", "durationMs"], "properties": { "startedAt": { "type": "string", "format": "date-time" }, "finishedAt": { "type": "string", "format": "date-time" }, "durationMs": { "type": "integer", "minimum": 0 } } },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["requestHash", "projectAdapterHash", "catalogHash", "scenarioId", "scenarioHash", "candidateSourceHash", "serviceIdentityHash", "destinationFingerprint", "contractManifestHash", "contractCombinedSha256", "operationIndexHash", "attestationHash", "observedOperations"],
      "properties": { "requestHash": { "$ref": "#/$defs/hash" }, "projectAdapterHash": { "$ref": "#/$defs/hash" }, "catalogHash": { "$ref": "#/$defs/hash" }, "scenarioId": { "$ref": "#/$defs/id" }, "scenarioHash": { "$ref": "#/$defs/hash" }, "candidateSourceHash": { "$ref": "#/$defs/hash" }, "serviceIdentityHash": { "$ref": "#/$defs/hash" }, "destinationFingerprint": { "$ref": "#/$defs/hash" }, "contractManifestHash": { "$ref": "#/$defs/hash" }, "contractCombinedSha256": { "$ref": "#/$defs/hash" }, "operationIndexHash": { "$ref": "#/$defs/hash" }, "attestationHash": { "$ref": "#/$defs/hash" }, "observedOperations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
    },
    "preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["identityMatched", "destinationAllowed", "runnerAvailable", "authenticationAvailable", "fixtureReady", "runtimeHealthy"],
      "properties": { "identityMatched": { "type": "boolean" }, "destinationAllowed": { "type": "boolean" }, "runnerAvailable": { "type": "boolean" }, "authenticationAvailable": { "type": "boolean" }, "fixtureReady": { "type": "boolean" }, "runtimeHealthy": { "type": "boolean" } }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["runnerId", "protocol", "commandHash", "serviceIdentityHash", "authProfileFingerprint", "attestationHash", "destinationId", "destinationFingerprint", "finalDestinationFingerprint", "redirected", "imageRef", "imageId", "containerId", "containerImageId", "composeProject"],
      "properties": { "runnerId": { "$ref": "#/$defs/id" }, "protocol": { "$ref": "#/$defs/protocol" }, "commandHash": { "$ref": "#/$defs/hash" }, "serviceIdentityHash": { "$ref": "#/$defs/hash" }, "authProfileFingerprint": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "attestationHash": { "$ref": "#/$defs/hash" }, "destinationId": { "$ref": "#/$defs/id" }, "destinationFingerprint": { "$ref": "#/$defs/hash" }, "finalDestinationFingerprint": { "$ref": "#/$defs/hash" }, "redirected": { "type": "boolean" }, "imageRef": { "type": ["string", "null"] }, "imageId": { "type": ["string", "null"] }, "containerId": { "type": ["string", "null"] }, "containerImageId": { "type": ["string", "null"] }, "composeProject": { "type": ["string", "null"] } }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "operationId", "method", "statusCode", "durationMs", "attempt", "outcome", "requestBodyHash", "responseBodyHash", "idempotencyKeyHash", "redactedFields"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "operationId": { "type": "string", "minLength": 1 }, "method": { "type": "string", "minLength": 1 }, "statusCode": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 }, "durationMs": { "type": "integer", "minimum": 0 }, "attempt": { "type": "integer", "minimum": 1, "maximum": 3 }, "outcome": { "enum": ["KNOWN", "UNKNOWN", "NOT_DISPATCHED"] }, "requestBodyHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "responseBodyHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "idempotencyKeyHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "redactedFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
      }
    },
    "steps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "status", "detail"], "properties": { "id": { "$ref": "#/$defs/id" }, "status": { "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"] }, "detail": { "type": "string" } } } },
    "assertions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "severity", "status", "expected", "actual", "impactKeys", "evidenceRefs", "findingFingerprint"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "type": "string", "minLength": 1 }, "severity": { "enum": ["REQUIRED", "ADVISORY"] }, "status": { "enum": ["PASS", "FAIL", "BLOCKED"] }, "expected": {}, "actual": {}, "impactKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/impactKey" } }, "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "findingFingerprint": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] } }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256", "sizeBytes", "modifiedAt"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/hash" }, "sizeBytes": { "type": "integer", "minimum": 0 }, "modifiedAt": { "type": "string", "format": "date-time" } } } },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "attempts", "targetFingerprint", "outcome", "resolution", "detail"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["business-write", "test-data", "external-call", "account-or-credential", "other"] }, "attempts": { "type": "integer", "minimum": 0, "maximum": 1 }, "targetFingerprint": { "$ref": "#/$defs/hash" }, "outcome": { "enum": ["KNOWN", "UNKNOWN", "NOT_DISPATCHED"] }, "resolution": { "enum": ["NOT_APPLICABLE", "RESTORED", "COMPENSATED", "PERSISTED_AUTHORIZED", "UNRESOLVED"] }, "detail": { "type": "string", "minLength": 1 } }
      }
    },
    "excluded": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "blockers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "reason", "nextStep"], "properties": { "code": { "$ref": "#/$defs/id" }, "reason": { "type": "string", "minLength": 1 }, "nextStep": { "type": "string", "minLength": 1 } } } }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "PASS" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "preflight": { "properties": { "identityMatched": { "const": true }, "destinationAllowed": { "const": true }, "runnerAvailable": { "const": true }, "authenticationAvailable": { "const": true }, "fixtureReady": { "const": true }, "runtimeHealthy": { "const": true } } },
          "steps": { "items": { "properties": { "status": { "enum": ["PASS", "SKIPPED"] } } } },
          "assertions": { "items": { "if": { "properties": { "severity": { "const": "REQUIRED" } }, "required": ["severity"] }, "then": { "properties": { "status": { "const": "PASS" } } } } },
          "mutations": { "items": { "properties": { "resolution": { "not": { "const": "UNRESOLVED" } }, "outcome": { "not": { "const": "UNKNOWN" } } } } },
          "blockers": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "FAIL" } }, "required": ["verdict"] },
      "then": { "properties": { "assertions": { "contains": { "properties": { "severity": { "const": "REQUIRED" }, "status": { "const": "FAIL" } }, "required": ["severity", "status"] } } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "BLOCKED" } }, "required": ["verdict"] },
      "then": { "properties": { "blockers": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "mutations": { "contains": { "properties": { "resolution": { "const": "UNRESOLVED" } }, "required": ["resolution"] } } }, "required": ["mutations"] },
      "then": { "properties": { "verdict": { "const": "BLOCKED" }, "blockers": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "requests": { "contains": { "properties": { "outcome": { "const": "UNKNOWN" } }, "required": ["outcome"] } } }, "required": ["requests"] },
      "then": { "properties": { "verdict": { "const": "BLOCKED" }, "blockers": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\]).+" },
    "protocol": { "enum": ["http", "graphql", "grpc", "websocket"] },
    "impactKey": { "type": "string", "pattern": "^(source|operation|schema|state|data|permission|config|contract|invariant|integration|runtime):.+$" }
  }
}
